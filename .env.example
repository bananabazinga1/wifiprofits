# ── Required ──────────────────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Your affiliate link for the product you are promoting
AFFILIATE_LINK=https://warriorplus.com/o2/a/YOURCODE/0

# ── Personalisation ───────────────────────────────────────────────────────────
# Name used to sign each email
SENDER_NAME=Your Name

# Description of your target audience (fed directly into the AI prompt)
AUDIENCE=online business beginners interested in making money from home

# ── Schedule (24-hour clock, local system time) ───────────────────────────────
MORNING_HOUR=8
AFTERNOON_HOUR=13
EVENING_HOUR=19

# ── Output ────────────────────────────────────────────────────────────────────
# Directory where generated emails are saved (relative to project root)
OUTPUT_DIR=output

# ── AI Model ─────────────────────────────────────────────────────────────────
# Options: claude-haiku-4-5 (fast/cheap), claude-sonnet-4-6 (balanced),
#          claude-opus-4-6 (highest quality)
CLAUDE_MODEL=claude-haiku-4-5

# ── Product Copy ──────────────────────────────────────────────────────────────
# Path to a text file containing the raw sales page copy for the product you are promoting.
# Paste the full copy from the product's sales page into this file.
# For campaign mode, you can also override this with: --product-copy path/to/copy.txt
# See product_copy_example.txt for the expected format.
PRODUCT_COPY_FILE=product_copy.txt
